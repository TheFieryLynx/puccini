{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOSCA 1.3 executable corpus evidence v2",
  "type": "object",
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "coverage",
          "assertions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "coverage": {
            "type": "object",
            "required": [
              "primary_requirements",
              "supporting_requirements"
            ],
            "properties": {
              "primary_requirements": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "supporting_requirements": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "requirement_ids",
                "kind",
                "path",
                "expected"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "kind": {
                  "enum": [
                    "accept",
                    "reject",
                    "value",
                    "diagnostic",
                    "phase",
                    "normalization"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "related_cases": {
            "type": "object",
            "properties": {
              "nearest_valid": {
                "type": "string"
              },
              "change": {
                "type": "string"
              },
              "exception": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
